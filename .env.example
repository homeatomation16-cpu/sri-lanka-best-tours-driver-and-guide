MONGODB_URI=
ADMIN_USERNAME=
ADMIN_PASSWORD=
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com

# Image uploads (optional). If empty, images are stored in MongoDB and served from /api/media/<id>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# All site e-mails (business cPanel mailbox; port 465 = TLS)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@example.com
SMTP_PASS=
# Sender; a bare address gets the brand name
SMTP_FROM=info@example.com
# Booking / enquiry notifications: main address + more, comma-separated (each gets its own copy)
ADMIN_EMAIL=info@example.com
ADMIN_NOTIFICATION_EMAILS=owner@example.com,manager@example.com

# Google sign-in for customer accounts (OAuth 2.0 Client ID, type "Web application")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public site address used in e-mail links
SITE_URL=https://srilankabesttourdriverandguide.com

# SEO: canonical site origin used for canonical URLs, hreflang, sitemap, Open Graph and JSON-LD.
# Leave empty in production (defaults to https://www.srilankabesttourdriverandguide.com). No trailing slash.
NEXT_PUBLIC_SITE_URL=
